# Telegram token created by @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token

# Comma-separated numeric Telegram user IDs. Usernames are not accepted.
TELEGRAM_ADMIN_IDS=123456789

# One ArvanCloud account used by every allowed Telegram administrator.
ARVANCLD_EMAIL=admin@example.com
ARVANCLD_PASSWORD=replace-with-account-password

# The Docker Compose file overrides this with /app/data/arvancld-session.json.
ARVANCLD_SESSION_PATH=data/arvancld-session.json
LOG_LEVEL=INFO

